# Skopíruj do koreňa projektu ako .env.production (NEcommitovať!)

# verejná adresa aplikácie (odkaz v QR kóde na osvedčení)
APP_URL=https://lms.uppvl.sk

# heslo do PostgreSQL – vygeneruj: openssl rand -hex 24
POSTGRES_PASSWORD=

# tajomstvo Payloadu (podpisuje session aj odkazy na potvrdenia) – vygeneruj: openssl rand -hex 32
PAYLOAD_SECRET=

# len na prvé naplnenie obsahu cez /seed (po prihlásení do /admin), potom riadok zmaž a reštartuj
# ALLOW_SEED=1

# --- Prihlásenie cez AD (LDAPS) ---
# viac DC oddeľ čiarkou, skúšajú sa po poradí
LDAP_URL=ldaps://UPPVL-VM-DC01.urad.vicepremier.gov.sk:636
LDAP_BIND_DN=svc.skolenie@urad.vicepremier.gov.sk
# heslo servisného účtu – vyplň ručne na serveri
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=OU=Domain users,DC=urad,DC=vicepremier,DC=gov,DC=sk
LDAP_UPN_SUFFIX=urad.vicepremier.gov.sk
LDAP_EXCLUDE_OUS=INTERNS
LDAP_ADMIN_GROUP=CN=DL_Skolenie_Admins,OU=DL,OU=Domain groups,DC=urad,DC=vicepremier,DC=gov,DC=sk
LDAP_MANAGER_GROUP=CN=DL_Skolenie_Veduci,OU=DL,OU=Domain groups,DC=urad,DC=vicepremier,DC=gov,DC=sk
# LDAP_CA_FILE nastavuje docker-compose.prod.yml (/app/certs/ca.cer)

# max. neúspešných pokusov na účet za 15 min – musí byť POD prahom zamknutia účtu v AD
LOGIN_MAX_ATTEMPTS=3

# tajomstvo pre nočnú synchronizáciu z AD (cron → /auth/sync) – vygeneruj: openssl rand -hex 32
SYNC_SECRET=

# verzia image: latest alebo sha-<commit> (rollback)
# IMAGE_TAG=latest
